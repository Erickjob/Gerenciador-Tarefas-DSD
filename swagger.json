{
  "openapi": "3.0.0",
  "info": {
    "title": "API Gateway - Gerenciador de Tarefas",
    "version": "1.0.0",
    "description": "API Gateway unificando microsserviços com JWT e HATEOAS"
  },
  "paths": {
    "/api/login": {
      "post": {
        "summary": "Autentica usuário e retorna token JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": { "type": "string", "example": "erick" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Sucesso" } }
      }
    },
    "/api/todos": {
      "get": {
        "summary": "Lista todas as tarefas (Requer JWT)",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Sucesso" } }
      },
      "post": {
        "summary": "Cadastra uma nova tarefa (Requer JWT)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string", "example": "Nova tarefa do laboratório" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Criado com sucesso" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}